# Base URL of the conversion API (backend pack). No secrets in the frontend.
NEXT_PUBLIC_API_BASE=https://api.filemyway.com/api/v1
# Public site URL, used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://filemyway.com
# Optional privacy-friendly analytics id.
NEXT_PUBLIC_ANALYTICS_ID=
# Dev/test only: use the in-memory mock API instead of the real backend.
NEXT_PUBLIC_USE_MOCK_API=false
